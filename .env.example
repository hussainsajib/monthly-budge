# Copy to .env (not committed) or export in your shell.
# Local default: SQLite file under ./data
DATABASE_URL=sqlite:///./data/budget.db
# Cloud Run + Cloud SQL (Postgres) example:
# DATABASE_URL=postgresql+psycopg2://budget:PASSWORD@/budget?host=/cloudsql/PROJECT:REGION:INSTANCE

# Set APP_PASSWORD to turn on HTTP Basic auth (required before exposing publicly).
APP_USER=admin
APP_PASSWORD=

# Optional: categorize new descriptions with a local LLM (Ollama).
# Leave unset to skip AI suggestions (dictionary-based autofill still works).
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:14b
